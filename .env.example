# Copy to .env and fill in. .env is git-ignored; passwords never go on the command line.

# --- the Windows machine ---
RDP_HOST=
RDP_USER=
RDP_PASSWORD=
# RDP_DOMAIN=
# RDP_PORT=3389
# RDP_WIDTH=1920
# RDP_HEIGHT=1080

# Pin the server certificate (get it with: uv run rdp-agent --fingerprint)
RDP_CERT_FINGERPRINT=
# or, on your own LAN only, skip the check:
# RDP_IGNORE_CERT=1

# Extra secrets a script can type (via type_secret) but that never appear in logs or reports, e.g.:
# RDP_SECRET_WIFI=
